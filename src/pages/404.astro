---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada · fmv" description="La página que buscás no existe en el sitio de fmv.">
  <main>
    <section class="pt-34 pb-18 sm:pt-40 sm:pb-24">
      <div class="wrap">
        <span class="label">// 404</span>
        <h1 class="mb-2 text-[28px] font-bold tracking-[-.01em]">Esta página no existe</h1>
        <p class="mb-8 max-w-[640px] text-muted">Puede que el link esté mal escrito o que la página se haya movido.</p>
        <a href="/" class="btn btn-ghost inline-block">Volver al inicio</a>
      </div>
    </section>
  </main>
</Base>
