---
import { paginas } from '../data/navegacion';

// La página actual se decide al construir; se normaliza la barra final para comparar.
const actual = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<nav
  id="nav"
  class="fixed inset-x-0 top-0 z-10 border-b border-transparent bg-bg/80 backdrop-blur-md transition-colors [&.scrolled]:border-line"
>
  <div class="wrap flex h-16 items-center justify-between">
    <a href="/" class="inline-block py-2 font-mono text-xl font-semibold text-matrix"
      >fmv<span class="text-muted">_</span></a
    >
    <ul class="-mr-1.5 flex list-none gap-1 text-[13px] sm:gap-4 sm:text-sm">
      {
        paginas.map(({ href, texto }) => (
          <li>
            <a
              href={href}
              aria-current={href === actual ? 'page' : undefined}
              class="inline-block px-1.5 py-3 text-muted transition-colors hover:text-matrix aria-[current=page]:text-matrix"
            >
              {texto}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  // Borde inferior del nav al hacer scroll.
  const nav = document.getElementById('nav')!;
  const actualizar = () => nav.classList.toggle('scrolled', scrollY > 10);
  addEventListener('scroll', actualizar, { passive: true });
  actualizar();
</script>
