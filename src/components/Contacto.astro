---
const canales = [
  { tipo: 'email', texto: 'tu-email@ejemplo.com', href: 'mailto:tu-email@ejemplo.com' },
  { tipo: 'linkedin', texto: '/in/tu-usuario', href: '#' },
  { tipo: 'github', texto: '@tu-usuario', href: '#' },
];
---

<section id="contacto" class="py-18 sm:py-24">
  <div class="wrap">
    <span class="label">// contacto</span>
    <h2 class="mb-2 text-[28px] font-bold tracking-[-.01em]">Hablemos</h2>
    <p class="mb-12 max-w-[640px] text-muted">¿Tenés un proyecto o una propuesta? Escribime.</p>
    <ul class="grid list-none gap-4 sm:grid-cols-3">
      {
        canales.map(({ tipo, texto, href }) => (
          <li>
            <a
              href={href}
              class="block rounded-xl border border-line bg-surface p-5 transition-all hover:border-matrix hover:shadow-[0_0_24px_var(--color-glow)]"
            >
              <small class="mb-1 block font-mono text-xs text-matrix">{tipo}</small>
              <strong class="text-sm font-medium break-all">{texto}</strong>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
