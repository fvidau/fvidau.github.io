---
import { experiencia } from '../data/experiencia';
---

<ol
  class="relative grid list-none gap-6 before:absolute before:top-7 before:bottom-7 before:left-[21px] before:w-px before:bg-gradient-to-b before:from-matrix before:to-line sm:before:left-[27px]"
>
  {
    experiencia.map(({ anio, rol, empresa, periodo, descripcion, tags }) => (
      <li class="grid grid-cols-[44px_1fr] items-start gap-3.5 sm:grid-cols-[56px_1fr] sm:gap-6">
        <span class="relative z-[1] grid size-11 place-items-center rounded-full border border-matrix bg-bg font-mono text-[11px] font-semibold text-matrix sm:size-14 sm:text-[13px]">
          {anio}
        </span>
        <article class="rounded-xl border border-line bg-surface px-6 py-[22px] transition-colors hover:border-line-hover">
          <h3 class="text-base font-semibold">{rol}</h3>
          <p class="mt-0.5 mb-2.5 text-[13px] text-muted">
            {empresa} · {periodo}
          </p>
          <p class="text-sm text-muted">{descripcion}</p>
          <ul class="mt-3.5 flex list-none flex-wrap gap-1.5" aria-label="Tecnologías">
            {tags.map((tag) => (
              <li class="rounded-full border border-matrix/35 px-2.5 py-[3px] font-mono text-[11px] text-matrix-dim">
                {tag}
              </li>
            ))}
          </ul>
        </article>
      </li>
    ))
  }
</ol>
